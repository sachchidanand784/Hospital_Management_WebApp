// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// CORE & SETTINGS
// -----------------------------------------------------------------------------

model Hospital {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  name_en          String
  name_hi          String?
  address_en       String
  address_hi       String?
  phones           String[]
  email            String?
  emergencyPhone   String?
  about_en         String?
  about_hi         String?
  logo             String?
  socialLinks      Json?
}

model HospitalTiming {
  id              String   @id @default(cuid())
  hospitalId      String
  weekday         Int      // 0 = Sunday, 1 = Monday, etc.
  open            String   // "HH:mm"
  close           String   // "HH:mm"
  isClosed        Boolean  @default(false)
  emergency24x7   Boolean  @default(true)
}

model Holiday {
  id                 String   @id @default(cuid())
  hospitalId         String
  date               DateTime @db.Date
  reason_en          String
  reason_hi          String?
  emergencyAvailable Boolean  @default(true)
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// USERS, STAFF & ROLES
// -----------------------------------------------------------------------------

enum Role {
  OWNER
  DOCTOR
  RECEPTION
  OPTOMETRIST
  PHARMACY
  OPTICAL
  OT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  DECLINED
  SUSPENDED
}

model User {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  role               Role
  email              String?   @unique
  mobile             String    @unique
  passwordHash       String
  status             String    @default("ACTIVE")
  language           String    @default("hi")
  lastLogin          DateTime?
  mustChangePassword Boolean   @default(false)

  doctorProfile Doctor?
  staffProfile  StaffProfile?
}

model Department {
  id        String         @id @default(cuid())
  name      String
  staff     StaffProfile[]
}

model StaffProfile {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  fullName     String
}

model Doctor {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  fullName           String
  gender             String?
  mobile             String
  email              String?
  qualification      String
  experienceYears    Int                @default(0)
  consultationFee    Int                @default(0)
  bio_en             String?
  bio_hi             String?
  photoUrl           String?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedBy         String?
  verifiedAt         DateTime?
  declineReason      String?

  specializations    Specialization[]   @relation("DoctorSpecializations")
  appointments       Appointment[]
  consultations      Consultation[]
  schedules          DoctorWeeklySchedule[]
  dateOverrides      DoctorDateOverride[]
  leaves             DoctorLeave[]
}

model Specialization {
  id        String   @id @default(cuid())
  name_en   String
  name_hi   String?
  icon      String?
  active    Boolean  @default(true)
  doctors   Doctor[] @relation("DoctorSpecializations")
}

// -----------------------------------------------------------------------------
// SERVICES & QUEUE CONFIG
// -----------------------------------------------------------------------------

model Service {
  id          String           @id @default(cuid())
  name_en     String
  name_hi     String?
  desc_en     String?
  desc_hi     String?
  icon        String?
  active      Boolean          @default(true)
  feeMode     String           @default("FIXED")
  problems    ServiceProblem[]
  appointments Appointment[]
}

model ServiceProblem {
  id         String   @id @default(cuid())
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  name_en    String
  name_hi    String?
  redFlag    Boolean  @default(false)
  
  appointments Appointment[]
}

model FeeRule {
  id          String   @id @default(cuid())
  serviceId   String?
  doctorId    String?
  dayOfWeek   Int?
  type        String   // "FREE" | "FIXED"
  amount      Int?
  label_en    String
  label_hi    String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
}

model QueueConfig {
  id               String  @id @default(cuid())
  doctorId         String?
  serviceId        String?
  tokenPrefix      String  // e.g., "A", "G"
  slotDuration     Int     // in mins
  patientsPerSlot  Int
  allowOverflow    Boolean @default(true)
  walkInPolicy     String  @default("ALLOWED")
  priorityRules    Json?
}

model Queue {
  id                String   @id @default(cuid()) // Format: doctorId_date or serviceId_date
  date              DateTime @db.Date
  currentServingSeq Int      @default(0)
  status            String   @default("OPEN") // OPEN | PAUSED | CLOSED
  
  appointments      Appointment[]
}

// -----------------------------------------------------------------------------
// DOCTOR SCHEDULING
// -----------------------------------------------------------------------------

model DoctorWeeklySchedule {
  id              String  @id @default(cuid())
  doctorId        String
  doctor          Doctor  @relation(fields: [doctorId], references: [id])
  weekday         Int     // 0-6
  startTime       String  // "HH:mm"
  endTime         String  // "HH:mm"
  slotDurationMin Int
  capacityPerSlot Int
  breakStart      String?
  breakEnd        String?
  active          Boolean @default(true)
}

model DoctorDateOverride {
  id              String   @id @default(cuid())
  doctorId        String
  doctor          Doctor   @relation(fields: [doctorId], references: [id])
  date            DateTime @db.Date
  startTime       String
  endTime         String
  slotDurationMin Int
  capacityPerSlot Int
}

model DoctorLeave {
  id       String   @id @default(cuid())
  doctorId String
  doctor   Doctor   @relation(fields: [doctorId], references: [id])
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason   String?
}

// -----------------------------------------------------------------------------
// PATIENTS & APPOINTMENTS
// -----------------------------------------------------------------------------

model Patient {
  id             String   @id @default(cuid())
  uhid           String   @unique // PRY-2026-000123
  name           String
  dob            DateTime? @db.Date
  age            Int?
  gender         String?
  mobile         String
  email          String?
  address        String?
  language       String   @default("hi")
  consentAt      DateTime?
  consentVersion String?
  createdAt      DateTime @default(now())

  appointments   Appointment[]
  surgeries      Surgery[]
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

model Appointment {
  id               String            @id @default(cuid())
  appointmentCode  String            @unique
  patientId        String
  patient          Patient           @relation(fields: [patientId], references: [id])
  serviceId        String
  service          Service           @relation(fields: [serviceId], references: [id])
  problemId        String?
  problem          ServiceProblem?   @relation(fields: [problemId], references: [id])
  doctorId         String?
  doctor           Doctor?           @relation(fields: [doctorId], references: [id])
  
  type             String            // SPECIFIC | GENERAL | WALKIN | EMERGENCY | FOLLOWUP
  date             DateTime          @db.Date
  slotStart        String?
  slotEnd          String?
  
  queueId          String?
  queue            Queue?            @relation(fields: [queueId], references: [id])
  tokenSeq         Int?
  tokenLabel       String?           // e.g., "A-018"
  
  status           AppointmentStatus @default(BOOKED)
  priority         Boolean           @default(false)
  source           String            @default("ONLINE")
  notes            String?
  
  cancellationReason String?
  rescheduledFromId  String?
  
  checkedInAt      DateTime?
  calledAt         DateTime?
  consultStartAt   DateTime?
  consultEndAt     DateTime?
  feeShown         Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  statusHistory    AppointmentStatusHistory[]
  examination      EyeExamination?
  consultation     Consultation?
  surgery          Surgery?
}

model AppointmentStatusHistory {
  id            String   @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  fromStatus    String
  toStatus      String
  changedBy     String?
  createdAt     DateTime @default(now())
}

// -----------------------------------------------------------------------------
// CLINICAL (CONSULTATION, PHARMACY, OPTICAL)
// -----------------------------------------------------------------------------

model EyeExamination {
  id                String      @id @default(cuid())
  appointmentId     String      @unique
  appointment       Appointment @relation(fields: [appointmentId], references: [id])
  technicianId      String?
  
  distVisionRight   String?
  distVisionLeft    String?
  nearVisionRight   String?
  nearVisionLeft    String?
  
  refractionRight   Json?       // { sph, cyl, axis, add }
  refractionLeft    Json?
  pd                String?
  iopRight          String?
  iopLeft           String?
  
  notes             String?
  sharedWithDoctorAt DateTime?
}

model Consultation {
  id               String       @id @default(cuid())
  appointmentId    String       @unique
  appointment      Appointment  @relation(fields: [appointmentId], references: [id])
  doctorId         String
  doctor           Doctor       @relation(fields: [doctorId], references: [id])
  
  notes            String?
  findings         String?
  diagnosis        String?
  treatmentPlan    String?
  testsAdvised     String?
  surgeryAdvised   Boolean      @default(false)
  surgeryType      String?
  followUpDate     DateTime?    @db.Date
  aiDraftUsed      Boolean      @default(false)

  prescription     Prescription?
}

model Prescription {
  id             String         @id @default(cuid())
  consultationId String         @unique
  consultation   Consultation   @relation(fields: [consultationId], references: [id])
  createdAt      DateTime       @default(now())
  items          PrescriptionItem[]
  requests       MedicineRequest[]
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  instructions   String?
  eye            String?      // RIGHT | LEFT | BOTH
  explain_en     String?
  explain_hi     String?
}

model Medicine {
  id          String  @id @default(cuid())
  name        String
  form        String?
  strength    String?
  stockStatus String  @default("IN_STOCK") // IN_STOCK | LOW | OUT
  qty         Int?
  shelf       String?
}

model MedicineRequest {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  status         String       @default("RECEIVED") // RECEIVED | PREPARING | READY | COLLECTED | UNAVAILABLE
  notes          String?
  queueToken     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model OpticalProduct {
  id           String  @id @default(cuid())
  name_en      String
  name_hi      String?
  desc_en      String?
  desc_hi      String?
  category     String  // FRAME | LENS | SUNGLASS | CONTACT_LENS | ACCESSORY
  brand        String?
  frameType    String?
  design       String?
  displayPrice Int?
  availability String  @default("AVAILABLE") // AVAILABLE | LOW | OUT | COMING_SOON
  tags         String[]
  active       Boolean @default(true)
  featured     Boolean @default(false)

  images       OpticalProductImage[]
}

model OpticalProductImage {
  id        String         @id @default(cuid())
  productId String
  product   OpticalProduct @relation(fields: [productId], references: [id])
  url       String
  order     Int            @default(0)
  altText_en String?
  altText_hi String?
}

// -----------------------------------------------------------------------------
// SURGERY (OT) & EMERGENCIES
// -----------------------------------------------------------------------------

model Surgery {
  id             String       @id @default(cuid())
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  
  type           String
  eye            String       // RIGHT | LEFT | BOTH
  surgeonId      String?
  advisedById    String?
  
  scheduledDate  DateTime?    @db.Date
  scheduledTime  String?
  otRoom         String?
  status         String       @default("ADVISED") // ADVISED | SCHEDULED | PRE_OP_DONE | IN_SURGERY | COMPLETED | POSTPONED | CANCELLED
  
  consentStatus  String?
  consentDate    DateTime?
  anesthesiaNotes String?
  postOpInst_en  String?
  postOpInst_hi  String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model EmergencyRequest {
  id            String   @id @default(cuid())
  name          String
  mobile        String
  email         String?
  problem       String
  incidentInfo  String?
  description   String?
  latitude      Float?
  longitude     Float?
  
  status        String   @default("NEW") // NEW | ACKNOWLEDGED | CONTACTED | ARRIVED | UNDER_TREATMENT | CLOSED
  aiSeverity    String?  // HIGH | MEDIUM | LOW
  aiReason      String?
  handledById   String?
  closeNote     String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// LOGS & CMS
// -----------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actor     String?
  role      String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}
